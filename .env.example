# Azul Chat — variables de entorno.
#
# Este archivo es el ÚNICO .env que se commitea. Los valores son de ejemplo y
# no sirven para nada real. Copialo a `.env.local` (ignorado por git) y poné
# ahí los valores de tu entorno.
#
# NINGUNA de estas variables lleva el prefijo NEXT_PUBLIC_: las lee solamente
# el servidor de Azul Chat. Ponerles ese prefijo las metería en el JavaScript
# que baja al navegador.

# URL base del ERP Azul, sin ruta, sin query y sin barra final.
# En producción tiene que ser https. http solo se acepta contra localhost.
ERP_BASE_URL=https://erp.ejemplo.invalid

# Secreto compartido SOLO entre Azul Chat y el ERP para firmar las consultas
# (HMAC-SHA256). Mínimo 32 caracteres, distinto del AUTH_SECRET del ERP.
# Sin este valor el cliente ERP queda APAGADO (fail closed): no hay default.
# Generarlo con:  node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AZUL_CHAT_INTEGRACION_SECRET=
