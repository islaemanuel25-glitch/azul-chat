# Azul Chat — variables de entorno.
#
# Este archivo es el ÚNICO .env que se commitea. Los valores son de ejemplo y
# no sirven para nada real. Copialo a `.env.local` (ignorado por git) y poné
# ahí los valores de tu entorno.
#
# NINGUNA de estas variables lleva el prefijo NEXT_PUBLIC_: las lee solamente
# el servidor de Azul Chat. Ponerles ese prefijo las metería en el JavaScript
# que baja al navegador.
#
# Si falta cualquiera de las obligatorias, Azul Chat no crea ni lee sesiones y
# no llama al ERP (fail closed). No hay valores por defecto.

# ── La base PROPIA de Azul Chat (no la del ERP) ─────────────────────────────
# PostgreSQL. Guarda la instalación, los vínculos (con el token CIFRADO) y las
# sesiones (con el hash de su identificador).
DATABASE_URL=postgresql://usuario:clave@localhost:5432/azulchat

# ── La instalación ──────────────────────────────────────────────────────────
# Identificador estable de la instalación del ERP a la que pertenece este
# despliegue. Minúsculas, números y guiones (3 a 63). No cambiarlo una vez que
# la base tiene datos: el servidor se niega a usar una base de otra instalación.
AZUL_CHAT_INSTALACION_ID=instalacion-de-ejemplo

# Origen público exacto desde el que se usa Azul Chat. Crear o cerrar una
# sesión exige que la cabecera Origin sea exactamente este valor.
# https en producción; http solo contra localhost.
AZUL_CHAT_ORIGEN_PUBLICO=https://chat.ejemplo.invalid

# ── El ERP ──────────────────────────────────────────────────────────────────
# URL base del ERP Azul, sin ruta, sin query y sin barra final.
# En producción tiene que ser https. http solo se acepta contra localhost.
ERP_BASE_URL=https://erp.ejemplo.invalid

# Secreto compartido SOLO entre Azul Chat y el ERP para firmar las llamadas
# (HMAC-SHA256). Mínimo 32 caracteres, distinto del AUTH_SECRET del ERP.
# Generarlo con:  node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AZUL_CHAT_INTEGRACION_SECRET=

# ── El cifrado del token de delegación ──────────────────────────────────────
# Clave de AES-256-GCM: EXACTAMENTE 32 bytes al azar, en base64 (44 caracteres
# con "=") o base64url (43). Distinta del secreto de la integración: si son
# iguales, el servidor se niega a arrancar la sesión. Perderla deja ilegibles
# los tokens guardados: hay que volver a vincular.
# Generarla con:  node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AZUL_CHAT_TOKEN_ENCRYPTION_KEY=
