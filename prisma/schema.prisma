// La base PROPIA de Azul Chat. No es la del ERP y nunca se conecta a ella.
//
// Guarda la identidad propia sobre la que delega el ERP —la instalación, el
// vínculo de cada persona y sus sesiones— y, desde la Tanda 2, los HECHOS del
// ERP que Azul Chat sincroniza (Evento), hasta dónde los trajo (CursorIngesta)
// y hasta dónde leyó cada persona (LecturaLocal). Ver docs/EVENTOS.md.
//
// Lo que NO se guarda, a propósito: el código de canje que la persona copió,
// su contraseña o cookie o JWT del ERP, y su rol, permisos, locales, grupo o
// capacidades. Eso es del ERP y se le pregunta en el momento (`mi_alcance`).
// Un evento guardado NO es un permiso para verlo: quién puede leer la historia
// de un local se decide cada vez con el ERP.
//
// Varias reglas viven solo en SQL (en las migraciones, al final): una sola
// instalación, la forma del token cifrado y del hash de sesión, la coherencia
// de fechas, la forma de la clave de un evento y el arriendo de la ingesta.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// La instalación del ERP a la que pertenece ESTE despliegue. Una sola fila:
/// Azul Chat no es multi-empresa. `id` es el valor de AZUL_CHAT_INSTALACION_ID;
/// si la base ya pertenece a otra instalación, el servidor no arranca la
/// sesión (fail closed).
model Instalacion {
  id       String          @id
  /// Siempre true: el índice único y un CHECK hacen que haya una sola fila.
  unica    Boolean         @unique @default(true)
  creadaEn DateTime        @default(now())
  vinculos Vinculo[]
  eventos  Evento[]
  cursores CursorIngesta[]
  accesos  AccesoPersona[]
}

/// Por qué se invalidó un vínculo.
enum MotivoInvalidacion {
  /// El ERP rechazó el token (VINCULO_NO_VALIDO): revocado, reautorizado o inexistente.
  TOKEN_RECHAZADO_POR_ERP
}

/// La delegación vigente de UNA persona del ERP en esta instalación. Una fila
/// por persona: al volver a vincularse (otro dispositivo, o después de una
/// revocación) se reemplazan el `erpVinculoId` y el token, y las sesiones de
/// los otros dispositivos siguen andando con el token nuevo.
///
/// Vigente = `invalidadoEn` en NULL.
model Vinculo {
  id                 String              @id @default(uuid())
  instalacionId      String
  erpUsuarioId       Int
  /// El id del VinculoIntegracion del ERP del que salió el token. Crece con
  /// cada autorización: un canje viejo que llega tarde no pisa uno nuevo.
  erpVinculoId       Int
  /// "v1.<iv>.<ciphertext>.<tag>", AES-256-GCM, base64url. Nunca el token claro.
  tokenCifrado       String
  vinculadoEn        DateTime            @default(now())
  /// Cuándo se canjeó en el ERP el código del token actual (lo informa el ERP).
  erpCanjeadoEn      DateTime
  invalidadoEn       DateTime?
  motivoInvalidacion MotivoInvalidacion?
  /// Tanda 11: el HORARIO DE SILENCIO de la persona. Apagado por defecto.
  /// Mientras está activo y la hora de Argentina cae en [desde, hasta) —que
  /// puede cruzar la medianoche, como 0 a 7 o 22 a 7—, la sincronización de
  /// fondo no manda push; la marca de avisos avanza igual, así que al salir del
  /// horario no llega el atraso. Horas enteras de 0 a 23, distintas (CHECK).
  /// Es de la persona en esta instalación: sobrevive a volver a vincularse.
  silencioActivo     Boolean             @default(false)
  silencioDesde      Int                 @default(0)
  silencioHasta      Int                 @default(7)
  /// Tanda 14: cuándo la sincronización de fondo le tocó a esta persona por
  /// última vez. Con varias personas, la corrida tiene un tope total de
  /// consultas al ERP; si no entran todas, empieza por las que hace más que no
  /// les toca (null primero). Solo ordena turnos: no es autoridad ni dato del ERP.
  ultimoTurnoFondoEn DateTime?
  /// Tanda 15: el nombre de la persona como lo dio el ERP la última vez
  /// (`mi_alcance`, `usuario.nombre`), para la lista de Accesos. Solo se
  /// muestra: no es autoridad. Sin nombre, la lista dice "Persona <id>".
  erpNombre          String?

  instalacion   Instalacion       @relation(fields: [instalacionId], references: [id], onDelete: Restrict)
  sesiones      Sesion[]
  lecturas      LecturaLocal[]
  suscripciones PushSuscripcion[]
  avisos        AvisoLocal[]
  preguntas     Pregunta[]

  @@unique([instalacionId, erpUsuarioId])
  @@unique([instalacionId, erpVinculoId])
}

/// Una sesión de un dispositivo. La cookie lleva un identificador opaco; acá
/// se guarda solo su SHA-256.
model Sesion {
  id         String    @id @default(uuid())
  /// SHA-256 (hex) del identificador de la cookie. El identificador no se guarda.
  idHash     String    @unique
  vinculoId  String
  creadaEn   DateTime  @default(now())
  expiraEn   DateTime
  revocadaEn DateTime?

  vinculo       Vinculo           @relation(fields: [vinculoId], references: [id], onDelete: Restrict)
  suscripciones PushSuscripcion[]

  @@index([vinculoId])
}

/// Los tipos de hecho del ERP que Azul Chat guarda. Uno nuevo es un valor más
/// acá, con su validador de payload en src/server/eventos/.
enum TipoEvento {
  TRANSFERENCIA_RECIBIDA
  /// Tanda 4B: capacidad `pedidos_eventos`, del local que pidió.
  PEDIDO_SOLICITADO
  /// Tanda 4B: capacidad `envios_eventos`, del local destino.
  TRANSFERENCIA_ENVIADA
  /// Tanda 4B: capacidad `cancelaciones_eventos`, del local destino.
  TRANSFERENCIA_CANCELADA
}

/// UN HECHO DEL ERP, guardado UNA vez. No es de una persona ni de una
/// conversación: la conversación de un local y General lo leen, y quién puede
/// verlo se decide con el ERP en cada consulta. Nunca se borra solo: si el ERP
/// borra la transferencia (reset-operativo), el evento queda como historia.
model Evento {
  /// Secuencia de INGESTA: el orden en que Azul Chat se enteró. La lectura se
  /// mide con esto, no con la fecha (ver docs/EVENTOS.md).
  id              BigInt     @id @default(autoincrement())
  instalacionId   String
  tipo            TipoEvento
  /// El `eventoId` del ERP, tal cual. Única dentro de la instalación.
  claveExterna    String
  /// El local del hecho: para TRANSFERENCIA_RECIBIDA, el destino. Es una
  /// referencia, NO una autorización.
  erpLocalId      Int
  /// El id de la entidad del ERP (la transferencia). Puede repetirse: un
  /// reset-operativo reutiliza ids, y la clave externa los distingue.
  erpReferenciaId Int
  /// Cuándo ocurrió en el ERP (fechaRecepcion). Orden de OPERACIÓN.
  fechaOperacion  DateTime   @db.Timestamp(3)
  payloadVersion  Int
  /// Lo que se muestra, validado por tipo y versión. Sin permisos ni personas.
  payload         Json
  /// Ingerido durante el backfill inicial: es historia, nunca "no leído".
  historico       Boolean
  ingeridoEn      DateTime   @default(now())

  instalacion Instalacion @relation(fields: [instalacionId], references: [id], onDelete: Restrict)

  @@unique([instalacionId, claveExterna])
  @@index([instalacionId, erpLocalId, id])
  @@index([instalacionId, erpLocalId, fechaOperacion, id])
  @@index([instalacionId, tipo, erpReferenciaId])
}

/// HASTA DÓNDE SE TRAJO cada local, por capacidad. Compartido por todas las
/// personas: el mismo evento no se baja una vez por cada una. No es un estado
/// de lectura.
model CursorIngesta {
  id                     String    @id @default(uuid())
  instalacionId          String
  erpLocalId             Int
  /// La capacidad del ERP que se pagina: transferencias_eventos,
  /// pedidos_eventos, envios_eventos o cancelaciones_eventos (CHECK en la base).
  capacidad              String
  /// El `siguiente` del ERP, tal cual lo devolvió. Null antes de la primera página.
  cursor                 Json?
  /// Cuándo el ERP contestó por primera vez `hayMas: false`. Hasta entonces, todo es histórico.
  backfillCompletoEn     DateTime?
  ultimaSincronizacionEn DateTime?
  /// El arriendo: quién sincroniza este local y hasta cuándo. Los dos o ninguno.
  arrendadoHasta         DateTime?
  arrendadoPor           String?
  /// El código del último fallo (nunca un mensaje). Un éxito lo limpia.
  ultimoErrorCodigo      String?
  ultimoErrorEn          DateTime?
  /// Diagnóstico, NO error: la última clave ya guardada que el ERP volvió a
  /// entregar con OTRO contenido (misma identidad). Se conservó la primera
  /// foto y la sincronización siguió. Un éxito no lo limpia: es historia.
  ultimaDiferenciaContenidoClave String?
  ultimaDiferenciaContenidoEn    DateTime?

  instalacion Instalacion @relation(fields: [instalacionId], references: [id], onDelete: Restrict)

  @@unique([instalacionId, erpLocalId, capacidad])
}

/// HASTA DÓNDE LEYÓ una persona en un local. Es del Vinculo —la persona en
/// esta instalación—, no de la sesión: dos dispositivos comparten lectura.
model LecturaLocal {
  vinculoId          String
  erpLocalId         Int
  /// El Evento.id (secuencia de ingesta) leído. Solo sube.
  leidoHastaEventoId BigInt
  actualizadoEn      DateTime @default(now()) @updatedAt

  vinculo Vinculo @relation(fields: [vinculoId], references: [id], onDelete: Restrict)

  @@id([vinculoId, erpLocalId])
}

/// Tanda 5A: UNA SUSCRIPCIÓN WEB PUSH de un dispositivo, para avisar con la
/// app cerrada. Es de la SESIÓN de ese dispositivo (y por ella, del vínculo):
/// cerrar la sesión, que venza o que el vínculo se invalide corta los avisos
/// de ese dispositivo. Guarda lo que el navegador entrega al suscribirse —el
/// endpoint del servicio de push y las claves públicas para cifrar— y nada
/// más: el endpoint no identifica a la persona en el ERP. Si el servicio de
/// push contesta 404 o 410, la suscripción se borra.
model PushSuscripcion {
  id                String    @id @default(uuid())
  vinculoId         String
  sesionId          String
  /// La URL del servicio de push (https, de un servicio conocido: ver CHECK y push/suscripcion.ts).
  endpoint          String    @unique
  /// Clave pública ECDH P-256 del navegador, base64url sin relleno (65 bytes).
  p256dh            String
  /// Secreto de autenticación del navegador, base64url sin relleno (16 bytes).
  auth              String
  creadaEn          DateTime  @default(now())
  ultimoEnvioEn     DateTime?
  /// El último envío que falló: cuándo y con qué código (nunca un mensaje).
  ultimoErrorEn     DateTime?
  ultimoErrorCodigo String?

  vinculo Vinculo @relation(fields: [vinculoId], references: [id], onDelete: Restrict)
  sesion  Sesion  @relation(fields: [sesionId], references: [id], onDelete: Restrict)

  @@index([vinculoId])
  @@index([sesionId])
}

/// Tanda 5A: HASTA DÓNDE SE CONSIDERÓ PARA AVISAR, por persona y local. Una
/// marca de agua sobre Evento.id, como LecturaLocal: los eventos nuevos tienen
/// siempre ids mayores, así que lo que quedó por debajo ya se avisó (o no
/// correspondía avisarlo) y no se vuelve a mirar. Es lo que hace que cada
/// evento se avise UNA sola vez.
model AvisoLocal {
  vinculoId            String
  erpLocalId           Int
  /// El mayor Evento.id del local ya considerado. Solo sube.
  avisadoHastaEventoId BigInt
  actualizadoEn        DateTime @default(now()) @updatedAt

  vinculo Vinculo @relation(fields: [vinculoId], references: [id], onDelete: Restrict)

  @@id([vinculoId, erpLocalId])
}

/// Tanda 6A: LO QUE SE GASTÓ EN LA IA QUE INTERPRETA PREGUNTAS, por mes
/// calendario de Argentina ("AAAA-MM"). Una fila por mes. Antes de llamar al
/// modelo se RESERVA el costo máximo de una pregunta con un UPDATE condicionado
/// a no pasar el tope (ia/consumo.ts); después se ajusta al uso real. Así dos
/// preguntas a la vez no pasan el tope entre las dos.
model ConsumoIa {
  mes           String   @id
  tokensEntrada BigInt   @default(0)
  /// Salida, con los tokens de razonamiento: Google los cobra como salida.
  tokensSalida  BigInt   @default(0)
  /// Millonésimas de dólar: lo reservado más lo ajustado. Entero, sin redondeos de coma flotante.
  costoMicroUsd BigInt   @default(0)
  /// Preguntas que llegaron al modelo (las que pasaron la reserva).
  preguntas     Int      @default(0)
  actualizadoEn DateTime @default(now()) @updatedAt
}

/// Tanda 6C: LAS PREGUNTAS EN LENGUAJE NATURAL, GUARDADAS CON SU RESPUESTA.
/// Por persona (vínculo) y por chat: `erpLocalId` es el Local donde se
/// preguntó, o null si fue en General. `resultado` es EXACTAMENTE lo que se le
/// contestó a la pantalla (RespuestaPregunta, versión `resultadoVersion`): una
/// foto de ese momento que no se recalcula. `requisitos` dice de qué locales y
/// capacidades trae datos el resultado ([{ localId, capacidad }]): para
/// MOSTRARLA, todos tienen que seguir anunciados hoy por mi_alcance (fallo
/// cerrado, como los eventos). No cuentan como no leídos, no avisan y no
/// marcan leído. Se borran a los 90 días, en la corrida de fondo.
model Pregunta {
  id               BigInt   @id @default(autoincrement())
  vinculoId        String
  erpLocalId       Int?
  texto            String
  creadaEn         DateTime @default(now()) @db.Timestamp(3)
  resultadoVersion Int
  resultado        Json
  requisitos       Json

  vinculo Vinculo @relation(fields: [vinculoId], references: [id], onDelete: Restrict)

  @@index([vinculoId, erpLocalId, creadaEn(sort: Desc), id(sort: Desc)])
  @@index([creadaEn])
}

/// Tanda 12: LA SALUD DE LA SINCRONIZACIÓN DE FONDO, Y EL INCIDENTE SI SE CAE.
/// UNA sola fila (`unica`, siempre true): NO es una fila por corrida. Cada
/// corrida de POST /api/interno/sincronizar anota su resultado acá —el último
/// éxito, la última falla con un motivo corto (un código cerrado, sin
/// secretos ni datos de negocio) y cuántas fallas van seguidas—, y el vigía
/// (POST /api/interno/vigia, cada 5 minutos) decide con esto si hay un
/// incidente y a quién avisar, una sola vez al abrirlo y una al cerrarlo
/// (src/server/interno/vigia.ts). Que el estado del incidente esté en la base
/// es lo que evita repetir el aviso aunque la app se reinicie.
model SaludSincronizacion {
  unica                  Boolean   @id @default(true)
  ultimoExitoEn          DateTime?
  ultimaFallaEn          DateTime?
  /// Código cerrado: ERP_NO_DISPONIBLE, ERP_CUPO_EXCEDIDO o BASE (CHECK).
  ultimaFallaMotivo      String?
  fallasSeguidas         Int       @default(0)
  /// La primera vez que el vigía miró y no había ninguna corrida registrada:
  /// desde ahí cuentan los 10 minutos de una base recién migrada.
  vigiaDesdeEn           DateTime?
  /// El incidente abierto: desde cuándo no se actualiza y por qué. Null: no hay.
  incidenteDesde         DateTime?
  /// ERP_NO_DISPONIBLE, ERP_CUPO_EXCEDIDO, BASE o SIN_CORRIDAS (CHECK).
  incidenteMotivo        String?
  /// Las personas (erpUsuarioId) a las que ya se les avisó que se abrió.
  avisadosApertura       Int[]     @default([])
  /// Las personas a las que todavía hay que avisarles que volvió (estaban en silencio al cerrarse).
  pendientesRecuperacion Int[]     @default([])
  actualizadoEn          DateTime  @default(now()) @updatedAt
}

/// Tanda 15: QUÉ PUEDE USAR CADA PERSONA EN AZUL CHAT. Una capa MÁS sobre lo que
/// da el ERP: solo puede restar, nunca sumar. Por persona del ERP
/// (`erpUsuarioId`), no por vínculo: volver a vincularse no la toca. Todo en
/// false por defecto: una persona sin fila no entra. Los administradores
/// (AZUL_CHAT_ADMINISTRADORES) no dependen de esta tabla: tienen todo.
model AccesoPersona {
  instalacionId           String
  erpUsuarioId            Int
  /// La app, la lista, los eventos, buscar, su configuración y los avisos. Sin esto, nada de lo demás vale.
  entrar                  Boolean   @default(false)
  ventas                  Boolean   @default(false)
  caja                    Boolean   @default(false)
  stock                   Boolean   @default(false)
  pendientes              Boolean   @default(false)
  /// Preguntar a la IA y ver sus preguntas guardadas.
  ia                      Boolean   @default(false)
  /// Quién lo cambió por última vez (un administrador, por su id del ERP) y cuándo. Juntos (CHECK).
  cambiadoPorErpUsuarioId Int?
  cambiadoEn              DateTime?

  instalacion Instalacion @relation(fields: [instalacionId], references: [id], onDelete: Restrict)

  @@id([instalacionId, erpUsuarioId])
}
