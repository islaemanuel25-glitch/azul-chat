# Dispara azul-chat-sincronizar.service cada 2 minutos (Tanda 5A).
# Instalación y comandos: docs/DEPLOY.md, sección "Sincronización en segundo plano".
#
# Por qué 2 minutos: el ERP admite 120 consultas por persona (240 por app) en
# una ventana fija de 60 s (erpmanual, lib/integraciones/azul-chat/limitador.js),
# que la app abierta comparte con esta corrida. Azul Chat igual presupuesta 30
# (CUPO_ERP_POR_PERSONA): la corrida gasta como mucho 18 por persona y le deja
# 12 a la app; con 2 minutos entre
# corridas, dos nunca caen en la misma ventana. El código usa este mismo
# periodo (PERIODO_SINCRONIZACION_MS) para "Actualización demorada": lo
# controla test/frontera/produccion.test.ts. Ver docs/DEPLOY.md.

[Unit]
Description=Disparo cada 2 minutos de la sincronización de Azul Chat

[Timer]
OnBootSec=2min
OnUnitActiveSec=2min
AccuracySec=10s

[Install]
WantedBy=timers.target
