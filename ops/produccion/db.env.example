# /srv/produccion/azul-chat/db.env — variables del contenedor azul-chat-db.
#
# Copiar a db.env en el servidor y completar ahí. NUNCA se commitea con valores.
# Permisos: 600.
#
# SOLO estas tres. Ningún secreto de la aplicación va acá: el contenedor de
# PostgreSQL no necesita el secreto de la integración ni la clave de cifrado, y
# no tiene que poder leerlos.
#
# La contraseña es la misma que va dentro de DATABASE_URL en app.env. Solo se
# usa al crear la base (primer arranque con ./pgdata vacío); cambiarla después
# requiere ALTER USER, no editar este archivo.
POSTGRES_USER=azulchat
POSTGRES_PASSWORD=
POSTGRES_DB=azulchat
