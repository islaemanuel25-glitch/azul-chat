# /srv/produccion/azul-chat/app.env — variables de la APLICACIÓN en producción.
#
# Copiar este archivo a app.env en el servidor y completar los valores ahí.
# NUNCA se commitea un app.env con valores. Permisos: 600, dueño quien despliega.
# Lo lee solo el contenedor azul-chat-app (docker-compose.prod.yml).
#
# Ninguna variable lleva NEXT_PUBLIC_. Si falta cualquiera, Azul Chat no crea ni
# lee sesiones y /api/salud contesta 503 (fail closed).
#
# APP_BUILD_ID NO va acá: viene adentro de la imagen, fijado en el build con el
# SHA del commit. Definirlo acá haría que /api/version mienta.
# NODE_ENV tampoco: lo fija docker-compose.prod.yml en production.

# La base PROPIA de Azul Chat, por la red interna del compose. El host es el
# nombre del servicio (azul-chat-db); el usuario, la contraseña y la base son
# los mismos que en db.env. Nunca la base del ERP.
#   postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@azul-chat-db:5432/<POSTGRES_DB>
DATABASE_URL=

# El ERP, solo por HTTPS público. Sin barra final ni ruta.
ERP_BASE_URL=https://operix.cloud

# El origen exacto desde el que la gente usa Azul Chat.
AZUL_CHAT_ORIGEN_PUBLICO=https://chat.operix.cloud

# Identificador estable de esta instalación. Minúsculas, números y guiones
# (3 a 63). Se fija una vez y no se cambia: la base queda atada a él.
AZUL_CHAT_INSTALACION_ID=

# Secreto HMAC COMPARTIDO SOLO con el ERP (el mismo valor configurado allá).
# Mínimo 32 caracteres. Se genera una vez, fuera del repo, y se carga en los
# dos lados por canales separados.
AZUL_CHAT_INTEGRACION_SECRET=

# Clave AES-256-GCM EXCLUSIVA de Azul Chat: 32 bytes al azar en base64 o
# base64url. NO es el secreto de la integración (si son iguales, no arranca) y
# el ERP no la conoce. Perderla obliga a que todos vuelvan a vincular: guardarla
# también fuera del servidor.
AZUL_CHAT_TOKEN_ENCRYPTION_KEY=
