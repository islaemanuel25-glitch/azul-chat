# Dispara azul-chat-vigia.service cada 5 minutos (Tanda 12).
# Instalación y comandos: docs/DEPLOY.md, sección "Vigía de la sincronización".
#
# Por qué 5 minutos: hay incidente si la sincronización (cada 2 minutos) lleva
# más de 10 sin un éxito, o 3 fallas seguidas (src/server/interno/vigia.ts).
# Mirando cada 5, un corte se avisa entre los 10 y los 15 minutos. El vigía no
# llama al ERP: no gasta cupo.

[Unit]
Description=Disparo cada 5 minutos del vigía de la sincronización de Azul Chat

[Timer]
OnBootSec=5min
OnUnitActiveSec=5min
AccuracySec=10s

[Install]
WantedBy=timers.target
